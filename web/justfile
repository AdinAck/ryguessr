# CI workflows for the ryguessr web component

set dotenv-load := true

# List available recipes
default:
    @just --list

# Build for production
build:
    npm run build

# Serve locally for development
dev:
    npm run dev

lint:
    npm run lint

# Rebuild on file changes
watch:
    watchexec -w app -w components -w lib -e ts,tsx,js,jsx,css,html -- npm run build

# Install dependencies
install:
    npm install
